# ============================================
# 智能旅行助手后端 - 环境变量模板
# ============================================
# 使用方法：
#   本地开发  -> 复制为 .env 并填入真实值（不要提交到 git）
#   HF Spaces -> 在 Settings → Repository Secrets 中逐个添加
# ============================================

# --- 必需配置 ---

# 高德地图 Web 服务 API Key（REST API 用）
AMAP_API_KEY=your_amap_api_key_here

# 高德地图 MCP Server 用（注意：环境变量名是 AMAP_MAPS_API_KEY，多了 MAPS）
AMAP_MAPS_API_KEY=your_amap_api_key_here_same_as_above

# LLM 配置（选一种即可）
# 方式一：阿里云 DashScope（本项目默认）
LLM_API_KEY=your_dashscope_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen3.8-max

# 方式二：OpenAI 兼容
# LLM_API_KEY=your_openai_api_key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_ID=gpt-4o-mini

# 最长等待秒数（思考模型生成大 JSON 慢，建议 600）
LLM_TIMEOUT=600

# Agent 实现：langgraph（推荐）| hello（原始 HelloAgents 框架）
AGENT_IMPL=langgraph

# --- CORS ---
# 前端地址（多个用逗号分隔）
# 本地开发：http://localhost:5173
# IGA Pages 部署后：https://smart-travel-ass-gm9abwlnd2-43bgll0ai9.preview.iga-pages.com
CORS_ORIGINS=http://localhost:5173

# --- 可选 ---
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
